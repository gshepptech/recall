#!/usr/bin/env bash
# Enable Recall auto-updates in the CURRENT git repo by installing chained
# post-commit + post-merge hooks that fire incremental scour. Idempotent and
# non-destructive: appends to existing hooks (honors core.hooksPath / husky).
set -u

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || { echo "✗ not inside a git repo"; exit 1; }

# install the engine to a stable path the hooks can call (outside any repo)
SRC_DIR="$(cd "$(dirname "$0")" && pwd)"
mkdir -p "$HOME/.recall/bin"
cp "$SRC_DIR/recall-incremental" "$HOME/.recall/bin/recall-incremental"
chmod +x "$HOME/.recall/bin/recall-incremental"

# resolve the hooks dir (respect core.hooksPath, e.g. husky)
HP="$(git -C "$ROOT" config core.hooksPath 2>/dev/null || true)"
if [ -n "$HP" ]; then
  case "$HP" in /*) HOOKDIR="$HP" ;; *) HOOKDIR="$ROOT/$HP" ;; esac
else
  HOOKDIR="$(git -C "$ROOT" rev-parse --git-path hooks 2>/dev/null)"
fi
mkdir -p "$HOOKDIR"

MARK="# >>> recall auto-scour >>>"
add_hook() {
  hook="$HOOKDIR/$1"; from="$2"
  if [ -f "$hook" ] && grep -q "recall auto-scour" "$hook" 2>/dev/null; then
    echo "• $1 already has Recall hook, skipping"; return
  fi
  [ -f "$hook" ] || printf '#!/usr/bin/env bash\n' > "$hook"
  {
    echo "$MARK"
    echo "\"\$HOME/.recall/bin/recall-incremental\" $from HEAD >/dev/null 2>&1 &"
    echo "# <<< recall auto-scour <<<"
  } >> "$hook"
  chmod +x "$hook"
  echo "✓ installed $1 hook"
}
add_hook post-commit "HEAD~1"
add_hook post-merge  "ORIG_HEAD"
echo "✓ Recall auto-scour enabled in $(basename "$ROOT"). Every commit and merge now refreshes shared memory."
