# ── Recall server config — copy to .env and fill in ──────────────────────────

# Auth: the owner bearer token (generate: python3 -c "import secrets;print(secrets.token_hex(16))")
RECALL_TOKEN=

# Server bind
RECALL_HOST=0.0.0.0
RECALL_PORT=8000
RECALL_PROJECT=global

# ── Storage ─────────────────────────────────────────────────────────────────
# SQLite (solo/testing):
DB_BACKEND=sqlite
RECALL_DB_PATH=./recall.db
# Postgres (team) — uncomment and set:
# DB_BACKEND=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=recall
# DB_USER=recall
# DB_PASSWORD=

# ── Semantic search (optional) ──────────────────────────────────────────────
# Keyword-only (zero egress): leave all of the below blank.
#
# Local embedder via bundled Ollama (semantic + zero egress):
#   docker compose up -d ollama && docker exec recall_ollama ollama pull nomic-embed-text
# OPENAI_API_BASE=http://localhost:11434/v1
# OPENAI_API_KEY=local
# RECALL_EMBEDDING_MODEL=nomic-embed-text
# RECALL_EMBED_DIM=768          # MUST equal the embedder's output dim (nomic=768, bge-large=1024, openai-3-large=3072)
#
# Cloud embedder (OpenAI — sends fact text out):
# OPENAI_API_KEY=sk-...
# RECALL_EMBEDDING_MODEL=text-embedding-3-large
# RECALL_EMBED_DIM=3072
